# Copy to .env.local (gitignored) and fill in.
# Set the same values in the Amplify environment variables for each branch
# (main / qa / prod) — a deployed build has no .env.local to fall back on.

# Secret used to sign the session JWT that the item service validates.
# It MUST match the JWT_SECRET of the org named by ORG_CODE below. While
# ORG_CODE is "sbht", that is the temple app's secret — otherwise every
# item-service call returns:
#   401 {"error":"Unauthorized: Missing or invalid token"}
#
# Server-side only. It is read inside the OTP route handler and is never
# imported into src/lib/config.ts or listed in next.config.ts, so it cannot
# reach the browser bundle. Do not add a NEXT_PUBLIC_ copy of it.
JWT_SECRET=

# Generic item service. Routes are {SERVICE_URL}/{ORG_CODE}/<route>.
SERVICE_URL=https://z7z4g52p2g.execute-api.ap-south-1.amazonaws.com

# Transactional email service used for sign-in codes.
SEND_EMAIL_URL=https://yzcjrbt1x1.execute-api.us-east-1.amazonaws.com

# Organisation the item rows belong to.
ORG_CODE=sbht

# Note: SERVICE_URL, SEND_EMAIL_URL and ORG_CODE are read by browser code.
# Next only exposes NEXT_PUBLIC_*-prefixed variables automatically, so these
# three are mapped to the client in next.config.ts. That is why they need no
# prefix here — but it also means they are compiled into the downloaded
# JavaScript and are not secret. Only put non-sensitive values in them.
