# Copy to .env.local (gitignored) and fill in.

# Secret used to sign the session JWT that the item service validates.
# It MUST match the JWT_SECRET of the org named by ORG_CODE in
# src/lib/config.ts. While ORG_CODE is "sbht", that is the temple app's
# JWT_SECRET — otherwise every item-service call returns:
#   401 {"error":"Unauthorized: Missing or invalid token"}
# Set the same value in the Amplify environment variables for each branch
# (main / qa / prod), or the deployed build will fail to sign in.
JWT_SECRET=
