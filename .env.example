# Copy to .env.local (gitignored) and fill in with the real values.
# Set the same variables in the Amplify environment variables for each branch
# (main / qa / prod) — a deployed build has no .env.local to fall back on.
#
# There are NO defaults in the code: every value below is required, and the app
# raises a named error at the point of use if one is missing. Nothing here is
# filled in on purpose, so no infrastructure address lives in the repository.

# Secret used to sign the session JWT that the item service validates.
# It MUST match the JWT_SECRET of the org named by ORG_CODE below, or every
# item-service call returns:
#   401 {"error":"Unauthorized: Missing or invalid token"}
#
# Server-side only. Read inside the OTP route handler; never imported into
# src/lib/config.ts and never listed in next.config.ts, so it cannot reach the
# browser bundle. Do not add a NEXT_PUBLIC_ copy of it.
JWT_SECRET=

# Generic item service. Routes are {SERVICE_URL}/{ORG_CODE}/<route>.
# e.g. https://<id>.execute-api.<region>.amazonaws.com
SERVICE_URL=

# Transactional email service used for sign-in codes.
# e.g. https://<id>.execute-api.<region>.amazonaws.com
SEND_EMAIL_URL=

# Organisation the item rows belong to.
ORG_CODE=

# Note: SERVICE_URL, SEND_EMAIL_URL and ORG_CODE are read by browser code.
# Next only exposes NEXT_PUBLIC_*-prefixed variables automatically, so these
# three are mapped to the client in next.config.ts. That is why they need no
# prefix here — but it also means they are compiled into the JavaScript the
# browser downloads and are therefore public. Only put non-sensitive values in
# them; anything genuinely secret belongs in a server-only variable like
# JWT_SECRET above.
